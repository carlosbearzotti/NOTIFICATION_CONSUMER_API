# ==============================================================================
# Configurações do Servidor SMTP de E-mails Reais - LãoBank Notification Consumer
# ==============================================================================
PORT=3002

# Provedor SMTP (Ex: smtp.gmail.com, smtp.resend.com, smtp-relay.brevo.com, smtp.office365.com, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Credenciais de Envio Real
# Para o Gmail: use seu e-mail e uma "Senha de Aplicativo" (App Password) gerada na Conta Google
# Para outros provedores (Resend/Brevo/SendGrid): use a API Key gerada no painel
SMTP_USER=
SMTP_PASS=

# Remetente Oficial
SMTP_FROM="LãoBank Digital <seguranca@laobank.com.br>"
